{%- liquid
  capture handles
    render 'hp-extras', field: 'handles'
  endcapture
  assign handle_list = handles | strip | split: '|'
-%}
<footer class="site-foot">
  <div class="site-foot__in">
    <div class="foot-brand">{% render 'hp-wordmark' %}</div>
    <div><h2>Shop</h2><ul>
      {%- for h in handle_list -%}
        {%- assign p = all_products[h] -%}
        {%- if p != blank and p.available -%}<li><a href="{{ p.url }}">{{ p.title | escape }}</a></li>{%- endif -%}
      {%- endfor -%}
    </ul></div>
    <div><h2>Explore</h2><ul>
      <li><a href="/pages/field-notes">Field Notes</a></li>
      <li><a href="{{ routes.root_url }}#story">About</a></li>
      <li><a href="{{ routes.cart_url }}">Cart</a></li>
    </ul></div>
    <div><h2>Say hello</h2><ul>
      <li><a href="mailto:hello@heavypocketsco.com">hello@heavypocketsco.com</a></li>
      <li><a href="https://www.instagram.com/heavypocketsco/" rel="noopener">Instagram @heavypocketsco</a></li>
      <li><a href="https://www.tiktok.com/@heavypocketsco" rel="noopener">TikTok @heavypocketsco</a></li>
    </ul></div>
  </div>
  <p class="fine">&copy; {{ 'now' | date: '%Y' }} Heavy Pockets Co.
    {%- for policy in shop.policies %} <a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endfor -%}
  </p>
</footer>

{% schema %}
{ "name": "Footer", "settings": [] }
{% endschema %}
