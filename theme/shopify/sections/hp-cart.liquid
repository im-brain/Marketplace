<section class="win win--paper cart" aria-labelledby="cart-h">
  <div class="bar"><span>Cart</span><span class="ctrls" aria-hidden="true"><i></i><i></i></span></div>
  <div class="cart__in">
    <h1 id="cart-h">Your cart</h1>
    {%- if cart.item_count == 0 -%}
      <div class="empty"><p>Your cart is as empty as a beach after a big storm. (Okay, emptier.)</p><a class="btn" href="{{ routes.root_url }}#shop">Shop the collection</a></div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate data-cart-form>
        <ul class="lines">
          {%- for item in cart.items -%}
            {%- assign label = item.product.title | append: ', ' | append: item.variant.title | escape -%}
            <li class="line">
              <a class="line__img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">{% if item.image %}<img src="{{ item.image | image_url: width: 300 }}" alt="" width="96" height="96" loading="lazy">{% endif %}</a>
              <div>
                <h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                <p class="line__meta">
                  {%- for o in item.options_with_values -%}
                    {%- assign on = o.name | downcase -%}
                    {%- if on contains 'color' or on contains 'colour' %}Color{% elsif on contains 'size' %}Size{% else %}{{ o.name | escape }}{% endif %}: {{ o.value | escape }}.{% unless forloop.last %} {% endunless -%}
                  {%- endfor -%}
                </p>
              </div>
              <p class="line__price">{{ item.final_line_price | money }}{% if item.quantity > 1 %}<br><span class="small">{{ item.final_price | money }} each</span>{% endif %}</p>
              <div class="line__ctrls">
                <div class="qty">
                  <button type="button" class="icon-btn js-only" data-qty-step="-1" aria-label="Decrease quantity of {{ label }}">&minus;</button>
                  <input type="number" inputmode="numeric" name="updates[]" min="0" max="10" value="{{ item.quantity }}" aria-label="Quantity of {{ label }}" data-qty>
                  <button type="button" class="icon-btn js-only" data-qty-step="1" aria-label="Increase quantity of {{ label }}">+</button>
                </div>
                <a class="link-btn" href="{{ item.url_to_remove }}">Remove<span class="visually-hidden"> {{ label }}</span></a>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <div class="summary">
          <div class="summary__row"><span>Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span><span>{{ cart.total_price | money }}</span></div>
          <p>Standard U.S. shipping is included. Taxes are calculated at checkout.</p>
          <button class="btn btn--secondary btn--block no-js-only" type="submit" name="update">Update cart</button>
          <button class="btn btn--block" type="submit" name="checkout">Check out</button>
          <a class="text-link text-link--dark" href="{{ routes.root_url }}#shop">Keep shopping</a>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
