<section class="win signup" aria-labelledby="signup-h-{{ section.id }}">
  <div class="bar"><span>Mailing list</span><span class="ctrls" aria-hidden="true"><i></i><i></i></span></div>
  <div class="signup__in">
    <div>
      <h2 id="signup-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.text | escape }}</p>
    </div>
    {%- form 'customer', id: 'signup-form', class: 'signup__form', novalidate: 'novalidate', data-signup: '' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,dibs">
      <label for="email-{{ section.id }}">Email address</label>
      <div class="signup__row">
        <input id="email-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" inputmode="email" spellcheck="false" required aria-describedby="email-msg-{{ section.id }} email-note-{{ section.id }}"{% if form.errors %} aria-invalid="true"{% endif %}>
        <button class="btn" type="submit">Keep me posted</button>
      </div>
      <p id="email-msg-{{ section.id }}" class="form-msg{% if form.errors %} err{% elsif form.posted_successfully? %} ok{% endif %}" role="status" aria-live="polite">
        {%- if form.posted_successfully? -%}You're on the list. One short email when the doors open.
        {%- elsif form.errors -%}{{ form.errors.messages['email'] | default: 'Please check your email address.' }}{%- endif -%}
      </p>
      <p id="email-note-{{ section.id }}" class="form-note">{{ section.settings.note | escape }}</p>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Mailing list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Want a note when the shop opens?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "One short email when the doors open." },
    { "type": "textarea", "id": "note", "label": "Privacy note", "default": "We keep your email address in our Shopify store and use it only for shop news. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Mailing list" }]
}
{% endschema %}
