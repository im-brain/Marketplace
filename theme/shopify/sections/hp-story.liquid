<section class="win win--teal story" id="story" aria-labelledby="story-h">
  <div class="bar"><span>About</span><span class="ctrls" aria-hidden="true"><i></i><i></i></span></div>
  <div class="story__in">
    <div class="story__main">
      {% render 'hp-ph', show: section.settings.ph_story %}
      <h2 id="story-h">{{ section.settings.heading | escape }}</h2>
      {{ section.settings.text }}
    </div>
    <div class="founder">
      {%- if section.settings.photo -%}
        {{ section.settings.photo | image_url: width: 800 | image_tag: loading: 'lazy', class: 'founder__photo', alt: section.settings.photo.alt }}
      {%- else -%}
        <div class="photo-ph" role="img" aria-label="Photo placeholder"><span>Photo of Brian</span><span>coming later</span></div>
      {%- endif -%}
      <div>
        {% render 'hp-ph', show: section.settings.ph_founder %}
        <h3>{{ section.settings.founder_heading | escape }}</h3>
        {{ section.settings.founder_text }}
        <a class="text-link" href="/pages/field-notes">Read the Field Notes{% render 'hp-icon', name: 'arrow' %}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nobody walks the shore and comes back empty-handed." },
    { "type": "richtext", "id": "text", "label": "Story", "default": "<p>You go down to the water for a short walk. You come back with a smooth gray stone, a bit of beach glass, and sand in your shoes. That small, happy weight in your pocket is what this shop is about.</p><p>You do not need to know a single rock name to belong here. Picking things up is plenty.</p>" },
    { "type": "checkbox", "id": "ph_story", "label": "Show the Placeholder tag on the story", "default": true },
    { "type": "image_picker", "id": "photo", "label": "Founder photo" },
    { "type": "text", "id": "founder_heading", "label": "Founder heading", "default": "Hi, I'm Brian." },
    { "type": "richtext", "id": "founder_text", "label": "Founder intro", "default": "<p>I'm the person behind Heavy Pockets. [Two or three sentences in Brian's own words go here: why he started the shop and what he likes to find.]</p>" },
    { "type": "checkbox", "id": "ph_founder", "label": "Show the Placeholder tag on the founder intro", "default": true }
  ],
  "presets": [{ "name": "About" }]
}
{% endschema %}
