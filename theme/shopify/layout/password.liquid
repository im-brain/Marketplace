<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
{%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
<meta name="theme-color" content="#102849">
{%- if settings.favicon %}
<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">
{%- else %}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23102849'/%3E%3Cellipse cx='16' cy='18' rx='10' ry='8' fill='%23A7472D'/%3E%3Cellipse cx='13' cy='15' rx='3' ry='2' fill='%23F3E8D2' opacity='.6'/%3E%3C/svg%3E">
{%- endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;600;700;800&family=Press+Start+2P&display=swap">
{{ 'brand-tokens.css' | asset_url | stylesheet_tag }}
{{ 'site.css' | asset_url | stylesheet_tag }}
{{ 'hp-shopify.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Runs before paint: marks JS, decides if the wet effect can run, and shows
  products already revealed this visit in full color (so Back shows them wet).
{%- endcomment -%}
<script>(function(){var d=document.documentElement;d.classList.remove('no-js');d.classList.add('js');
var rm=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
var clip=window.CSS&&CSS.supports&&CSS.supports('clip-path','polygon(0 0,100% 0,0 100%)');
if(!rm&&clip)d.classList.add('wet-fx');
try{var w=JSON.parse(sessionStorage.getItem('hp.wet')||'[]');if(Array.isArray(w)&&w.length){var c=[];w.forEach(function(s){if(/^[a-z0-9-]+$/.test(s)){c.push('[data-product="'+s+'"] .wet__top{clip-path:none!important}[data-product="'+s+'"] .wet__base img{filter:none!important}')}});var st=document.createElement('style');st.textContent=c.join('');document.head.appendChild(st)}}catch(e){}})();</script>
<script src="{{ 'theme.js' | asset_url }}" defer></script>
{{ content_for_header }}
</head>
<body data-page="password">
<main id="main" tabindex="-1">
{{ content_for_layout }}
</main>
</body>
</html>
