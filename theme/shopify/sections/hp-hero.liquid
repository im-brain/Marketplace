<section class="hero" aria-labelledby="hero-h-{{ section.id }}">
  <div class="hero__art">
    <picture>
      <source media="(max-width: 700px)" type="image/webp" srcset="{{ 'hero-shore-tall.webp' | asset_url }}">
      <source media="(max-width: 700px)" srcset="{{ 'hero-shore-tall.jpg' | asset_url }}">
      <source type="image/webp" srcset="{{ 'hero-shore-wide.webp' | asset_url }}">
      <img src="{{ 'hero-shore-wide.jpg' | asset_url }}" width="1334" height="887" fetchpriority="high" decoding="async"
        alt="Pixel-art sunset over a Great Lakes shore, with a lighthouse on the point and wet beach stones in the foreground.">
    </picture>
  </div>
  <div class="hero__copy">
    {%- if section.settings.kicker != blank %}<p class="px kicker-px">{{ section.settings.kicker | escape }}</p>{% endif %}
    <h1 id="hero-h-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.sub != blank %}<p class="hero__sub">{{ section.settings.sub | escape }}</p>{% endif %}
    {%- if section.settings.button != blank %}<a class="btn" href="#shop">{{ section.settings.button | escape }}{% render 'hp-icon', name: 'arrow' %}</a>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line above", "default": "Head down. Pockets full." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Come home with heavy pockets." },
    { "type": "textarea", "id": "sub", "label": "Text", "default": "Tees and hoodies drawn like an old nature guide, for rockhounds, beachcombers, lake people, and anyone who just likes the art." },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop all six" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
