<section class="hero" aria-labelledby="pw-h">
  <div class="hero__art">
    <picture>
      <source media="(max-width: 700px)" type="image/webp" srcset="{{ 'hero-shore-tall.webp' | asset_url }}">
      <source type="image/webp" srcset="{{ 'hero-shore-wide.webp' | asset_url }}">
      <img src="{{ 'hero-shore-wide.jpg' | asset_url }}" width="1334" height="887" fetchpriority="high" decoding="async" alt="Pixel-art sunset over a Great Lakes shore, with a lighthouse on the point.">
    </picture>
  </div>
  <div class="hero__copy">
    <a class="brand" href="{{ routes.root_url }}" aria-label="heavy pockets">{% render 'hp-wordmark' %}</a>
    <p class="px kicker-px">Head down. Pockets full.</p>
    <h1 id="pw-h">{{ shop.password_message | default: 'Opening soon.' | escape }}</h1>
  </div>
</section>
<section class="win signup" aria-labelledby="pw-login-h">
  <div class="bar"><span>Store password</span><span class="ctrls" aria-hidden="true"><i></i><i></i></span></div>
  <div class="signup__in">
    <div><h2 id="pw-login-h">Have the password?</h2><p>The shop is closed while it gets built.</p></div>
    {%- form 'storefront_password', class: 'signup__form' -%}
      <label for="pw">Password</label>
      <div class="signup__row">
        <input id="pw" type="password" name="password" autocomplete="current-password"{% if form.errors %} aria-invalid="true" aria-describedby="pw-msg"{% endif %}>
        <button class="btn" type="submit">Enter</button>
      </div>
      {%- if form.errors %}<p id="pw-msg" class="form-msg err" role="status">That password did not work.</p>{% endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
